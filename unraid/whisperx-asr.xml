<?xml version="1.0"?>
<Container version="2">
  <Name>whisperx-asr</Name>
  <Repository>learnedmachine/whisperx-asr-service:latest</Repository>
  <Registry>https://hub.docker.com/r/learnedmachine/whisperx-asr-service</Registry>
  <Network>br0.100</Network>
  <MyIP>192.168.100.115</MyIP>
  <MyMAC/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/murtaza-nasir/whisperx-asr-service/issues</Support>
  <Project>https://github.com/murtaza-nasir/whisperx-asr-service</Project>
  <ReadMe>https://github.com/murtaza-nasir/whisperx-asr-service#readme</ReadMe>
  <Overview>WhisperX ASR Service: Automatic Speech Recognition with Word-Level Timestamps and Speaker Diarization. OpenAI-compatible endpoints, runs on NVIDIA GPU for a fully local transcription pipeline with model caching.</Overview>
  <Category>AI:Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT=9000]/docs</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/gnolnos/mos-hub-templates/main/unraid/whisperx-asr.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/m-bain/whisperX/main/assets/logo.png</Icon>
  <ExtraParams>--gpus all</ExtraParams>
  <PostArgs>&amp;amp;&amp;amp; docker network connect hass-network whisperx-asr &amp;amp;&amp;amp; docker network connect ai-network whisperx-asr</PostArgs>
  <CPUset>1,2,3,4,5,6</CPUset>
  <DateInstalled>1795632000</DateInstalled>
  <DonateText>Support WhisperX development</DonateText>
  <DonateLink>https://github.com/m-bain/whisperX</DonateLink>
  <Requires/>
  <Config Name="API Port" Target="9000" Default="9000" Mode="tcp" Description="WhisperX ASR REST API + /docs." Type="Port" Display="always" Required="true" Mask="false">9000</Config>
  <Config Name="HF_TOKEN" Target="HF_TOKEN" Default="" Mode="{3}" Description="Hugging Face read token (hf_...). REQUIRED for speaker diarization. Accept agreements for pyannote/speaker-diarization-community-1, pyannote/speaker-diarization-3.1, pyannote/segmentation-3.0." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="DEVICE" Target="DEVICE" Default="cuda" Mode="{3}" Description="cuda (NVIDIA GPU) or cpu." Type="Variable" Display="always" Required="true" Mask="false">cuda</Config>
  <Config Name="COMPUTE_TYPE" Target="COMPUTE_TYPE" Default="float16" Mode="{3}" Description="float16 (GPU), float32 (CPU), int8 (CPU)." Type="Variable" Display="always" Required="true" Mask="false">float16</Config>
  <Config Name="BATCH_SIZE" Target="BATCH_SIZE" Default="16" Mode="{3}" Description="Larger = faster but more memory (default 16 on cuda)." Type="Variable" Display="always" Required="false" Mask="false">16</Config>
  <Config Name="PRELOAD_MODEL" Target="PRELOAD_MODEL" Default="large-v3" Mode="{3}" Description="Model to load at startup (large-v3, small, medium, turbo, ...)." Type="Variable" Display="always" Required="false" Mask="false">large-v3</Config>
  <Config Name="MAX_FILE_SIZE_MB" Target="MAX_FILE_SIZE_MB" Default="1000" Mode="{3}" Description="Reject larger uploads to prevent OOM." Type="Variable" Display="advanced" Required="false" Mask="false">1000</Config>
  <Config Name="Cache Dir" Target="/.cache" Default="/mnt/appdata/appdata/whisperx" Mode="rw" Description="Cache for WhisperX ASR + pyannote diarization models." Type="Path" Display="always" Required="true" Mask="false">/mnt/appdata/appdata/whisperx</Config>
  <Config Name="Jobs Dir" Target="/tmp/whisperx-jobs" Default="/mnt/appdata/appdata/whisperx/jobs" Mode="rw" Description="Per-request working files. Use a volume with free space." Type="Path" Display="advanced" Required="false" Mask="false">/mnt/appdata/appdata/whisperx/jobs</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="{3}" Description="" Type="Variable" Display="always" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="{3}" Description="" Type="Variable" Display="always" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="022" Mode="{3}" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">022</Config>
  <TailscaleStateDir/>
</Container>
