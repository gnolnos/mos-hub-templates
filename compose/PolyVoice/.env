# =========================================================
# PolyVoice - cấu hình chain lồng tiếng đa ngôn ngữ
# Chỉnh port/path/model theo máy MOS của bạn.
# =========================================================
TZ=Asia/Saigon
APP_DATA=/mnt/cache/appdata/polyvoice

# --- WhisperX (ASR đa ngôn ngữ + diarization) ---
WHISPERX_PORT=9000
WHISPERX_MODEL=small

# --- ASR tiếng Việt (REST /transcribe) ---
ASR_API_PORT=8090
ASR_WYOMING_PORT=10301
ASR_MODEL=hynt/Zipformer-30M-RNNT-6000h
ASR_INT8=true
ASR_THREADS=4
# HF_TOKEN bắt buộc cho ASR nếu model gated; để trống nếu model public
HF_TOKEN=

# --- Piper TTS + REST bridge ---
PIPER_PORT=10200
PIPER_API_PORT=5002
# Voice Piper (xem thư viện giọng: torch.piper / piper voices list)
PIPER_VOICE=vi_VN-vais1000-medium
PIPER_LANGS=vi,vi_VN

# --- Ollama (LLM) ---
OLLAMA_PORT=11434
# GPU CPU/AMD/self-build: ollama/ollama (CPU+NVIDIA auto) | ollama/ollama:rocm (AMD)
LLM_IMAGE=ollama/ollama:latest
# Model LLM muốn pull tự động (vd qwen2.5:3b) — để trống nếu pull tay
OLLAMA_MODEL=
